# Production environment for docker-compose.prod.yml — copy to `.env` and fill in.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Signs sessions and JWTs (>= 32 bytes).
URUK_SECRET_KEY=
# Postgres password (set before the first start; the volume keeps the first value).
URUK_DB_PASSWORD=
# Hostnames the site answers on, comma-separated.
URUK_ALLOWED_HOSTS=example.com,www.example.com
# The only address allowed to claim the first superuser. Required: the site is public.
URUK_ADMIN_EMAIL=you@example.com
# URL prefix of the admin (default uruk -> https://example.com/uruk/).
URUK_ADMIN_PATH=uruk
# blank = an empty landing page to fill in; showcase = the packaged Uruk website.
URUK_DEFAULT_SITE=blank
# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > the token in the install command.
CLOUDFLARE_TUNNEL_TOKEN=
# Days of nightly database dumps kept in ./backups.
URUK_BACKUP_KEEP_DAYS=14
